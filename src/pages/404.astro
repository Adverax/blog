---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена" description="Запрошенная страница не существует.">
  <section class="py-16 text-center">
    <p class="text-sm font-semibold text-brand-600">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Страница не найдена</h1>
    <p class="mt-3 text-gray-600">
      Возможно, статья перемещена или ссылка устарела.
    </p>
    <a
      href="/blog"
      class="mt-6 inline-block rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors duration-150 hover:bg-brand-700 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none"
    >
      Вернуться в блог
    </a>
  </section>
</BaseLayout>
