---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPublishedPosts } from '../lib/posts';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="grid items-center gap-10 py-10 md:grid-cols-[1.2fr_1fr] md:py-14">
    <div class="text-center md:text-left">
      <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
        Energy software for the unstable grid.
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-lg text-gray-600 md:mx-0">
        Architecture decisions, integration war stories, and field notes from
        building IoT that keeps homes running when the grid doesn't.
      </p>
      <div class="mt-6 flex justify-center gap-3 md:justify-start">
        <a
          href="/blog"
          class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors duration-150 hover:bg-brand-700 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none"
        >
          Read the blog
        </a>
      </div>
    </div>

    <!--
      Decorative hero: a power line between two poles above a horizon of
      houses, broken in the middle — the unstable-grid motif. Inline SVG:
      no extra request, tunable via Tailwind utility classes.
    -->
    <div class="order-first md:order-last">
      <svg
        viewBox="0 0 360 240"
        role="img"
        aria-label="Illustration: a power line broken between two poles above a horizon of houses."
        class="mx-auto h-auto w-full max-w-md"
      >
        <!-- soft sky wash -->
        <rect x="0" y="0" width="360" height="210" class="fill-brand-50" />

        <!-- sun -->
        <circle cx="298" cy="58" r="36" class="fill-amber-200" opacity="0.45" />
        <circle cx="298" cy="58" r="24" class="fill-amber-300" opacity="0.85" />

        <!-- ground line -->
        <line x1="0" y1="210" x2="360" y2="210" class="stroke-gray-300" stroke-width="1.5" />

        <!-- houses -->
        <polygon points="36,210 36,188 70,160 104,188 104,210" class="fill-gray-700" />
        <polygon points="138,210 138,178 180,148 222,178 222,210" class="fill-gray-800" />
        <!-- a solar panel on the south slope of the middle house -->
        <polygon points="183,164 215,178 213,184 181,170" class="fill-brand-600" />
        <polygon points="248,210 248,192 278,166 308,192 308,210" class="fill-gray-700" />

        <!-- power poles -->
        <line x1="85" y1="210" x2="85" y2="92" class="stroke-gray-600" stroke-width="2" />
        <line x1="76" y1="98" x2="94" y2="98" class="stroke-gray-600" stroke-width="2" />
        <line x1="275" y1="210" x2="275" y2="92" class="stroke-gray-600" stroke-width="2" />
        <line x1="266" y1="98" x2="284" y2="98" class="stroke-gray-600" stroke-width="2" />

        <!-- cable, broken mid-air -->
        <path d="M 85 100 Q 130 140 168 130" fill="none" class="stroke-gray-600" stroke-width="2" stroke-linecap="round" />
        <path d="M 192 130 Q 230 140 275 100" fill="none" class="stroke-gray-600" stroke-width="2" stroke-linecap="round" />

        <!-- spark at the break -->
        <path d="M 184 116 L 178 128 L 186 128 L 180 144" fill="none" class="stroke-amber-500" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
      </svg>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="mt-12">
        <h2 class="text-sm font-semibold tracking-wide text-gray-500 uppercase">
          Latest posts
        </h2>
        <ul class="mt-4 divide-y divide-gray-200">
          {posts.map((post) => (
            <li class="py-4">
              <a href={`/blog/${post.id}`} class="group block">
                <p class="text-xs text-gray-500">
                  <FormattedDate date={post.data.pubDate} />
                </p>
                <h3 class="mt-1 font-semibold text-gray-900 group-hover:text-brand-600">
                  {post.data.title}
                </h3>
                <p class="mt-1 text-sm text-gray-600 line-clamp-2">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
