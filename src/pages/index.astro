---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPublishedPosts } from '../lib/posts';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="grid items-center gap-10 py-10 md:grid-cols-[1.2fr_1fr] md:py-14">
    <div class="text-center md:text-left">
      <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
        Systems built to hold where they're not allowed to fail.
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-lg text-gray-600 md:mx-0">
        From home energy to the way software itself gets built. Field notes,
        one layer up from any product.
      </p>
      <div class="mt-6 flex justify-center gap-3 md:justify-start">
        <a
          href="/blog"
          class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors duration-150 hover:bg-brand-700 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none"
        >
          Read the blog
        </a>
      </div>
    </div>

    <!--
      Decorative hero: a load carried at the centre of a taut span between two
      anchors — the span dips but holds, unbroken end to end ("meant to hold").
      Below it, a quiet stack of layers this work sits one layer above ("one
      layer up from any product"). Inline SVG: no extra request, tunable via
      Tailwind utility classes.
    -->
    <div class="order-first md:order-last">
      <svg
        viewBox="0 0 360 240"
        role="img"
        aria-label="Illustration: a load held at the centre of a taut, unbroken span between two anchors, standing one layer above a stack."
        class="mx-auto h-auto w-full max-w-md"
      >
        <!-- the product layers below: the stack this work sits one layer above -->
        <rect x="60" y="214" width="240" height="9" rx="2" class="fill-brand-100" />
        <rect x="80" y="205" width="200" height="9" rx="2" class="fill-brand-200" />
        <rect x="100" y="196" width="160" height="9" rx="2" class="fill-brand-300" />

        <!-- baseline the anchors stand on -->
        <line x1="40" y1="190" x2="320" y2="190" class="stroke-gray-300" stroke-width="1.5" />

        <!-- two anchors -->
        <line x1="85" y1="190" x2="85" y2="88" class="stroke-gray-600" stroke-width="3" stroke-linecap="round" />
        <line x1="275" y1="190" x2="275" y2="88" class="stroke-gray-600" stroke-width="3" stroke-linecap="round" />

        <!-- the span: dips under load but holds — unbroken end to end -->
        <path d="M 85 92 Q 180 172 275 92" fill="none" class="stroke-brand-600" stroke-width="3" stroke-linecap="round" />

        <!-- the load carried at the centre of the span -->
        <line x1="180" y1="132" x2="180" y2="140" class="stroke-gray-600" stroke-width="2" />
        <rect x="168" y="140" width="24" height="18" rx="3" class="fill-gray-800" />
      </svg>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="mt-12">
        <h2 class="text-sm font-semibold tracking-wide text-gray-500 uppercase">
          Latest posts
        </h2>
        <ul class="mt-4 divide-y divide-gray-200">
          {posts.map((post) => (
            <li class="py-4">
              <a href={`/blog/${post.id}`} class="group block">
                <p class="text-xs text-gray-500">
                  <FormattedDate date={post.data.pubDate} />
                </p>
                <h3 class="mt-1 font-semibold text-gray-900 group-hover:text-brand-600">
                  {post.data.title}
                </h3>
                <p class="mt-1 text-sm text-gray-600 line-clamp-2">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
