---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AuthorBio from '../components/AuthorBio.astro';
import Cta from '../components/Cta.astro';
import Comments from '../components/Comments.astro';
import { DEFAULT_AUTHOR, SITE_TITLE, AUTHOR_BIO } from '../consts';
import { canonical } from '../lib/url';
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt, tags } =
  post.data;
const author = post.data.author ?? DEFAULT_AUTHOR;

// JSON-LD Article — structured data для Google.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    jobTitle: AUTHOR_BIO.jobTitle,
    sameAs: AUTHOR_BIO.links.map((l) => l.href),
  },
  publisher: { '@type': 'Person', name: SITE_TITLE },
  mainEntityOfPage: canonical(Astro.url.pathname, Astro.site),
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={heroImage?.src}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    slot="head"
    is:inline
  />

  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 text-sm text-gray-500">
        <FormattedDate date={pubDate} />
        {updatedDate && <span> · updated <FormattedDate date={updatedDate} /></span>}
        <span> · {author}</span>
      </p>
      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroAlt ?? title}
          class="mb-8 rounded-xl"
          loading="eager"
        />
      )
    }

    <div class="prose prose-gray max-w-none prose-a:text-brand-600">
      <slot />
    </div>

    <AuthorBio />
    <Cta />
    <Comments />
  </article>
</BaseLayout>
