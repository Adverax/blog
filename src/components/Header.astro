---
import { SITE_TITLE } from '../consts';
---

<header class="border-b border-gray-200 bg-white">
  <nav
    class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="text-lg font-bold tracking-tight text-gray-900 hover:text-brand-600"
    >
      {SITE_TITLE}
    </a>
    <div class="flex items-center gap-6 text-sm font-medium text-gray-600">
      <a href="/blog" class="hover:text-brand-600">Blog</a>
      <a href="/about" class="hover:text-brand-600">About</a>
    </div>
  </nav>
</header>
