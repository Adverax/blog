---
import { SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-white">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-2 px-4 py-8 text-sm text-gray-500 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {SITE_TITLE}</p>
    <div class="flex gap-4">
      <a href="/rss.xml" class="hover:text-brand-600">RSS</a>
      <a
        href="https://github.com/adverax/blog"
        class="hover:text-brand-600"
        rel="noopener"
      >
        GitHub
      </a>
    </div>
  </div>
</footer>
